// Bergasports — Prisma Postgres (primary database)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  email        String   @id
  passwordHash String   @map("password_hash")
  role         String   @default("admin")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("admin_users")
}

model Product {
  id                 BigInt   @id
  data               Json     @db.JsonB
  slug               String?
  name               String?
  brand              String?
  category           String?
  catalogSource      String?  @map("catalog_source")
  priceCurrent       Decimal? @map("price_current") @db.Decimal(12, 2)
  priceDiscounted    Decimal? @map("price_discounted") @db.Decimal(12, 2)
  currency           String?
  image              String?
  url                String?
  featuredOnHomepage Boolean  @default(false) @map("featured_on_homepage")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([updatedAt(sort: Desc)])
  @@index([slug])
  @@index([featuredOnHomepage, updatedAt(sort: Desc)])
  @@map("products")
}

model Category {
  id                   Int       @id
  name                 String
  slug                 String
  parentId             Int       @map("parent_id")
  productCount         Int       @default(0) @map("product_count")
  link                 String?
  importCompletedAt    DateTime? @map("import_completed_at") @db.Timestamptz(6)
  importedProductCount Int?      @map("imported_product_count")
  seoIntro             String?   @map("seo_intro")
  seoFooterHtml        String?   @map("seo_footer_html")
  seoMetaTitle         String?   @map("seo_meta_title")
  seoMetaDescription   String?   @map("seo_meta_description")
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([slug])
  @@index([parentId])
  @@map("categories")
}

model CatalogMeta {
  id        Int      @id @default(1)
  source    String?
  sourceApi String?  @map("source_api")
  fetchedAt String?  @map("fetched_at")
  seller    String?
  sellerId  Int?     @map("seller_id")
  scrapedAt String?  @map("scraped_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("catalog_meta")
}

model Order {
  id                   BigInt   @id @default(autoincrement())
  orderNumber          String   @unique @map("order_number")
  status               String
  customerName         String   @map("customer_name")
  customerEmail        String?  @map("customer_email")
  customerPhone        String   @map("customer_phone")
  shippingAddress      String   @map("shipping_address")
  shippingCity         String   @map("shipping_city")
  shippingCounty       String?  @map("shipping_county")
  shippingPostalCode   String?  @map("shipping_postal_code")
  notes                String?
  paymentMethod        String   @default("cash_on_delivery") @map("payment_method")
  molliePaymentId      String?  @map("mollie_payment_id")
  currency             String
  subtotal             Decimal  @db.Decimal(12, 2)
  discountTotal        Decimal  @map("discount_total") @db.Decimal(12, 2)
  total                Decimal  @db.Decimal(12, 2)
  marketingConsent     Boolean  @default(false) @map("marketing_consent")
  easySalesSyncStatus  String?  @map("easy_sales_sync_status")
  easySalesSyncError   String?  @map("easy_sales_sync_error")
  easySalesSyncedAt    DateTime? @map("easy_sales_synced_at") @db.Timestamptz(6)
  statusEmailsSent     Json?    @map("status_emails_sent") @db.JsonB
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  items OrderItem[]

  @@index([createdAt(sort: Desc)])
  @@index([status])
  @@index([molliePaymentId])
  @@map("orders")
}

model OrderItem {
  id              BigInt  @id @default(autoincrement())
  orderId         BigInt  @map("order_id")
  productId       BigInt? @map("product_id")
  lineId          String? @map("line_id")
  name            String
  quantity        Int
  unitPrice       Decimal @map("unit_price") @db.Decimal(12, 2)
  lineTotal       Decimal @map("line_total") @db.Decimal(12, 2)
  currency        String
  image           String?
  variationLabel  String? @map("variation_label")
  bundleTierId    String? @map("bundle_tier_id")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_items")
}

model SitePage {
  id              Int      @id @default(autoincrement())
  slug            String   @unique
  path            String
  title           String
  heading         String?
  bodyHtml        String   @default("") @map("body_html")
  blocks          Json?    @db.JsonB
  metaTitle       String?  @map("meta_title")
  metaDescription String?  @map("meta_description")
  isPublished     Boolean  @default(true) @map("is_published")
  sortOrder       Int      @default(0) @map("sort_order")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([path])
  @@map("site_pages")
}

/** Admin-bewerkbare integratiekeys (override op env). */
model SiteSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by")

  @@map("site_settings")
}

model AnalyticsSession {
  id                String   @id @default(uuid()) @db.Uuid
  visitorId         String   @map("visitor_id")
  sessionId         String   @unique @map("session_id")
  countryCode       String?  @map("country_code")
  city              String?
  region            String?
  latitude          Float?   @db.DoublePrecision
  longitude         Float?   @db.DoublePrecision
  userAgent         String?  @map("user_agent")
  referrer          String?
  currentPath       String   @default("/") @map("current_path")
  currentProductId  BigInt?  @map("current_product_id")
  cartItemsCount    Int      @default(0) @map("cart_items_count")
  cartOpen          Boolean  @default(false) @map("cart_open")
  checkoutActive    Boolean  @default(false) @map("checkout_active")
  firstSeenAt       DateTime @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt        DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)

  pageViews AnalyticsPageView[]

  @@index([lastSeenAt(sort: Desc)])
  @@index([firstSeenAt(sort: Desc)])
  @@map("analytics_sessions")
}

model AnalyticsPageView {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @map("session_id")
  path      String
  productId BigInt?  @map("product_id")
  viewedAt  DateTime @default(now()) @map("viewed_at") @db.Timestamptz(6)

  session AnalyticsSession @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)

  @@index([viewedAt(sort: Desc)])
  @@index([path])
  @@map("analytics_page_views")
}

model ProductImageAsset {
  sourceUrl    String   @id @map("source_url")
  storagePath  String   @map("storage_path")
  publicUrl    String   @map("public_url")
  contentType  String?  @map("content_type")
  byteSize     Int?     @map("byte_size")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt(sort: Desc)])
  @@map("product_image_assets")
}

model MarketingEmailLog {
  id        BigInt   @id @default(autoincrement())
  email     String
  kind      String
  orderId   BigInt?  @map("order_id")
  sentAt    DateTime @default(now()) @map("sent_at") @db.Timestamptz(6)

  @@index([email, kind])
  @@index([sentAt(sort: Desc)])
  @@map("marketing_email_log")
}

model MarketingCronRun {
  id         BigInt   @id @default(autoincrement())
  job        String   @default("win_back")
  ranAt      DateTime @default(now()) @map("ran_at") @db.Timestamptz(6)
  candidates Int      @default(0)
  sent       Int      @default(0)
  ok         Boolean  @default(true)
  detail     String?

  @@index([job, ranAt(sort: Desc)])
  @@map("marketing_cron_runs")
}

model MarketingChannelInsight {
  channel               String   @id
  adSpendRon            Decimal  @default(0) @map("ad_spend_ron") @db.Decimal(14, 2)
  attributedRevenueRon  Decimal  @default(0) @map("attributed_revenue_ron") @db.Decimal(14, 2)
  impressions           BigInt   @default(0)
  clicks                BigInt   @default(0)
  conversions           Int      @default(0)
  campaigns             Json     @default("[]") @db.JsonB
  notes                 String?
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("marketing_channel_insights")
}

model PagespeedReport {
  id                  String   @id @default(uuid()) @db.Uuid
  strategy            String
  url                 String
  analyzedUrl         String?  @map("analyzed_url")
  fetchedAt           DateTime @map("fetched_at") @db.Timestamptz(6)
  performanceScore    Int?     @map("performance_score") @db.SmallInt
  accessibilityScore  Int?     @map("accessibility_score") @db.SmallInt
  bestPracticesScore  Int?     @map("best_practices_score") @db.SmallInt
  seoScore            Int?     @map("seo_score") @db.SmallInt
  reportJson          Json     @map("report_json") @db.JsonB
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([strategy, createdAt(sort: Desc)])
  @@map("pagespeed_reports")
}

model AiGeneratedImage {
  id                String    @id @default(uuid()) @db.Uuid
  productId         Int?      @map("product_id")
  productName       String?   @map("product_name")
  templateId        String    @map("template_id")
  shopCategorySlug  String?   @map("shop_category_slug")
  sourceImageUrl    String?   @map("source_image_url")
  referenceImageUrl String?   @map("reference_image_url")
  storagePath       String    @map("storage_path")
  publicUrl         String    @map("public_url")
  prompt            String
  overlay           Json?     @db.JsonB
  includeFlags      Json?     @map("include_flags") @db.JsonB
  installedAt       DateTime? @map("installed_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([productId])
  @@index([createdAt(sort: Desc)])
  @@map("ai_generated_images")
}

model AiImageCategoryTemplate {
  categorySlug String   @id @map("category_slug")
  templateId   String   @map("template_id")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("ai_image_category_templates")
}

model NewsPost {
  id              String    @id @default(cuid())
  slug            String    @unique
  slugEn          String?   @unique @map("slug_en")
  title           String
  titleEn         String?   @map("title_en")
  excerpt         String?
  excerptEn       String?   @map("excerpt_en")
  bodyHtml        String    @default("") @map("body_html")
  bodyHtmlEn      String?   @map("body_html_en")
  coverImage      String?   @map("cover_image")
  category        String?
  locale          String    @default("nl")
  relatedProductIds Json?   @map("related_product_ids") @db.JsonB
  publishedAt     DateTime? @map("published_at") @db.Timestamptz(6)
  isPublished     Boolean   @default(true) @map("is_published")
  sourceUrl       String?   @map("source_url")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([publishedAt(sort: Desc)])
  @@index([isPublished, publishedAt(sort: Desc)])
  @@map("news_posts")
}

model Coupon {
  id            String    @id @default(cuid())
  code          String    @unique
  type          String    @default("percent")
  amount        Decimal   @db.Decimal(12, 2)
  minSubtotal   Decimal?  @map("min_subtotal") @db.Decimal(12, 2)
  active        Boolean   @default(true)
  startsAt      DateTime? @map("starts_at") @db.Timestamptz(6)
  endsAt        DateTime? @map("ends_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("coupons")
}

model Customer {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String?
  phone        String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  addresses CustomerAddress[]

  @@map("customers")
}

model CustomerAddress {
  id           String   @id @default(cuid())
  customerId   String   @map("customer_id")
  label        String?
  line1        String
  line2        String?
  postalCode   String   @map("postal_code")
  city         String
  country      String   @default("NL")
  isDefault    Boolean  @default(false) @map("is_default")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_addresses")
}

model ShippingRate {
  id              String   @id @default(cuid())
  countryCode     String   @map("country_code")
  label           String
  method          String   @default("standard")
  price           Decimal  @db.Decimal(12, 2)
  freeAbove       Decimal? @map("free_above") @db.Decimal(12, 2)
  estimatedDays   String?  @map("estimated_days")
  active          Boolean  @default(true)
  sortOrder       Int      @default(0) @map("sort_order")

  @@index([countryCode, active])
  @@map("shipping_rates")
}
