{
  "name": "bergasports",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/run-next.mjs dev",
    "build": "prisma generate && node scripts/run-next.mjs build",
    "start": "next start -p 3060",
    "lint": "eslint",
    "import:wordpress": "npx tsx scripts/import-wordpress.ts",
    "import:wordpress:dry-run": "npx tsx scripts/import-wordpress.ts --dry-run",
    "export:seo-redirects": "npx tsx scripts/export-seo-redirects.ts",
    "import:bergasports": "node scripts/import-bergasports-catalog.mjs",
    "import:bergasports:dry-run": "node scripts/import-bergasports-catalog.mjs --dry-run",
    "catalog:purge-legacy": "node scripts/purge-non-bergasports-catalog.mjs",
    "catalog:export-json": "node scripts/export-bergasports-catalog-json.mjs",
    "catalog:seed-featured": "node scripts/seed-bergasports-featured.mjs",
    "catalog:reset": "npm run catalog:purge-legacy && npm run import:bergasports && npm run catalog:export-json && npm run catalog:seed-featured",
    "migrate:product-images": "node scripts/migrate-product-images-to-storage.mjs",
    "migrate:product-images:all": "bash scripts/run-image-migration-batches.sh",
    "migrate:product-images:complete": "node scripts/complete-product-image-migration.mjs",
    "sanitize:description-images": "node scripts/sanitize-product-description-images.mjs",
    "sanitize:description-images:all": "bash scripts/run-sanitize-description-batches.sh",
    "sanitize:description-images:complete": "node scripts/complete-sanitize-description-images.mjs",
    "pagespeed:mobile": "node scripts/run-pagespeed-mobile.mjs",
    "verify:phase1-plan": "node scripts/verify-phase1-plan.mjs",
    "test:smtp-order": "npx tsx scripts/test-smtp-order-email.ts",
    "normalize:category-links": "node scripts/normalize-category-links.mjs",
    "seed:site-pages": "npx tsx scripts/seed-site-pages.ts",
    "admin:user": "npx tsx scripts/create-admin-user.ts",
    "stock:init": "npx tsx scripts/set-initial-stock.ts",
    "cat:assign": "npx tsx scripts/recategorize-products.ts",
    "migrate:prisma": "node scripts/run-prisma-migration.mjs",
    "mirror:all-images": "BASE_URL=http://localhost:3060 node scripts/mirror-all-product-images.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@vercel/blob": "^2.8.0",
    "cobe": "^2.0.1",
    "jose": "^6.2.3",
    "next": "16.2.4",
    "nodemailer": "^8.0.7",
    "pg": "^8.21.0",
    "quill": "^2.0.3",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@prisma/client": "^7.8.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
