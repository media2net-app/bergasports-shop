# Kopieer naar .env.local:
#   cp .env.local.example .env.local
#
# Verplicht om lokaal te starten: DATABASE_URL + ADMIN_JWT_SECRET

# --- Verplicht ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
ADMIN_JWT_SECRET="vervang-door-minstens-16-willekeurige-tekens"

# Canonical URL (zonder trailing slash). Lokaal: http://localhost:3060
NEXT_PUBLIC_SITE_URL="http://localhost:3060"

# --- Winkelgegevens (optioneel, ook via /admin/settings) ---
SHOP_PHONE=""
SHOP_EMAIL=""
SHOP_ADDRESS=""
SHOP_KVK=""
SHOP_VAT_NUMBER=""
SHOP_OPENING_HOURS_SHORT=""
WHATSAPP_NUMBER=""
LOW_STOCK_THRESHOLD="5"

# --- Betalingen (Mollie) ---
# Zonder API-key werkt checkout niet.
# Ingeschakelde methodes (iDEAL, Bancontact, creditcard, …) komen live uit Mollie — niet hardcoded.
MOLLIE_API_KEY=""
# Optioneel websiteprofiel (pfl_…)
MOLLIE_PROFILE_ID=""

# --- E-mail: SMTP of Resend (één van de twee is genoeg) ---
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Bergasports <info@bergasports.com>"
SMTP_SECURE="true"

RESEND_API_KEY=""

ORDER_NOTIFICATION_EMAIL=""
ORDER_NOTIFICATION_FROM="Bergasports <info@bergasports.com>"
NEXT_PUBLIC_EMAIL_LOGO_URL=""

# --- Analytics & marketing (optioneel) ---
NEXT_PUBLIC_GA4_ID=""
NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_GOOGLE_ADS_ID=""
GOOGLE_MERCHANT_CENTER_ID=""
NEXT_PUBLIC_TIKTOK_PIXEL_ID=""
TIKTOK_EVENTS_API_ACCESS_TOKEN=""

# Optioneel. Instagram Login (instagram_business_basic), long-lived token.
# Zonder token: homepage toont eigen winkelfoto's die naar het profiel linken.
# USER_ID is optioneel; de feed gebruikt GET /me/media.
INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_USER_ID=""
INSTAGRAM_PUBLIC_URL="https://www.instagram.com/bergasportsnl/"

# Optioneel. Google Places voor live reviews op homepage/contact.
# Zonder key: sectie met CTA naar Google + eventuele uitgelichte citaten in /admin/settings/google.
GOOGLE_PLACES_API_KEY=""
GOOGLE_PLACE_ID=""
GOOGLE_PLACE_RATING=""
GOOGLE_PLACE_RATING_COUNT=""

# Vereist in productie voor GET /api/cron/marketing-winback
CRON_SECRET=""
MARKETING_WINBACK_CODE="TERUG10"
MARKETING_WINBACK_EXPIRY_DAYS="14"

# --- Sendcloud (optioneel, labels & tracking) ---
SENDCLOUD_PUBLIC_KEY=""
SENDCLOUD_SECRET_KEY=""

# --- WhatsApp (optioneel, footer) ---
# WHATSAPP_NUMBER staat bij Winkelgegevens hierboven.

# --- Easy Sales (optioneel, order/stock sync) ---
EASY_SALES_API_TOKEN=""
EASY_SALES_WEBSITE_TOKEN=""
EASY_SALES_API_BASE_URL="https://easy-sales.com/api/v2"
EASY_SALES_CLIENT_ID=""
EASY_SALES_CLIENT_SECRET=""

# --- WooCommerce / WordPress oude site (optioneel) ---
# REST API: WP-admin → WooCommerce → Instellingen → Geavanceerd → REST API (rechten: Lezen).
# Gebruikt door: admin Import, order-sync, npm run import:wordpress
# Nieuws/pagina's werken vaak ook zonder keys via publieke /wp-json/wp/v2.
WC_STORE_BASE_URL="https://www.bergasports.com"
WC_CONSUMER_KEY=""
WC_CONSUMER_SECRET=""
# Alleen voor WP-concepten (nooit de Woo ck_/cs_ hier). Leeg = publieke /wp/v2 posts+pages.
WP_APP_USER=""
WP_APP_PASSWORD=""

# --- AI-productbeelden (optioneel) ---
OPENAI_API_KEY=""
MAGNIFIC_API_KEY=""
FREEPIK_API_KEY=""

# --- Overig (optioneel) ---
BLOB_READ_WRITE_TOKEN=""
GOOGLE_PAGESPEED_API_KEY=""
# Drempel gratis verzending naar NL in euro. Leeg = 150. Admin-instelling wint van env.
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD_EUR=""
REPEAT_ORDER_DISCOUNT_PERCENT="10"
REPEAT_ORDER_PROMO_CODE="CLIENT10"

# Legacy fallback als DATABASE_URL ontbreekt (niet gebruiken in productie)
# ADMIN_PASSWORD=""
