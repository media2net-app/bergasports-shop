# Kopieer naar .env.local:
#   cp .env.local.example .env.local
#
# Verplicht om lokaal te starten: DATABASE_URL + ADMIN_JWT_SECRET

# --- Verplicht ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
ADMIN_JWT_SECRET="vervang-door-minstens-16-willekeurige-tekens"

# Canonical URL (zonder trailing slash). Lokaal: http://localhost:3060
NEXT_PUBLIC_SITE_URL="http://localhost:3060"

# --- Betalingen (Mollie) ---
# Zonder API-key werkt checkout niet.
MOLLIE_API_KEY=""
# Optioneel websiteprofiel (pfl_…)
MOLLIE_PROFILE_ID=""

# --- E-mail: SMTP of Resend (één van de twee is genoeg) ---
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Bergasports <info@bergasports.com>"
SMTP_SECURE="true"

RESEND_API_KEY=""

ORDER_NOTIFICATION_EMAIL=""
